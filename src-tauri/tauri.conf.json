{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CajuTerm",
  "version": "1.1.0",
  "identifier": "dev.cajuterm.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CajuTerm",
        "width": 1240,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data: blob:; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/conpty/x64/conpty.dll": "conpty.dll",
      "vendor/conpty/x64/OpenConsole.exe": "OpenConsole.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
