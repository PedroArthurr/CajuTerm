{
  "name": "cajuterm",
  "private": true,
  "version": "1.1.0",
  "description": "CajuTerm — Terminal GPU/WebGL altamente personalizável para Windows 10/11 com PowerShell e ConPTY",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
